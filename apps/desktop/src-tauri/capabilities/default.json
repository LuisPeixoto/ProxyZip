{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart"
  ]
}
